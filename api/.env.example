APP_NAME=BulkScrubsDirect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Storefront session (Sanctum SPA auth) ----------------------------------
# In production Nginx serves the Nuxt storefront and this API from ONE origin,
# so these are first-party cookies: no CORS and no cross-site cookie problems.
#
# SANCTUM_STATEFUL_DOMAINS must list every host the storefront is served from.
# Sanctum decides whether to start a session from the request's Referer/Origin,
# and Nuxt sends NUXT_PUBLIC_SITE_URL as the Origin on server-rendered API
# calls — if the two disagree, every SSR page renders as a logged-out guest.
FRONTEND_URL=https://bulkscrubsdirect.ca
SESSION_DOMAIN=.bulkscrubsdirect.ca
SANCTUM_STATEFUL_DOMAINS=bulkscrubsdirect.ca,www.bulkscrubsdirect.ca

# --- Social sign-in (§3) -----------------------------------------------------
# Google is the launch-preferred provider. Create an OAuth 2.0 Client ID in the
# Google Cloud console, and register the callback below as an authorised
# redirect URI. Sign-in stays disabled and says so until both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bulkscrubsdirect.ca/api/v1/auth/google/callback

# Apple sign-in is out of scope (decided 2026-09-04). Google is the only social
# provider; there are no APPLE_* keys to set.

# --- Address lookup at checkout ----------------------------------------------
# Suggests the address as the customer types and fills in city, province and
# postal code. ADDRESS_LOOKUP_PROVIDER picks the service, and only that
# service's credential is read. With it unset the form is typed by hand,
# exactly as before.
#
# mapbox — Address Autofill, the Mapbox product licensed for filling in forms
#   (the cheaper Geocoding API is not: its results may not be stored, and an
#   order stores its address). Billed per address looked up, not per keystroke.
#
#   MAPBOX_PUBLIC_TOKEN is a PUBLIC token (pk.…) from
#   console.mapbox.com/account/access-tokens. It is sent to the browser, which
#   talks to Mapbox directly, so restrict it there to the storefront's URL
#   (https://bulkscrubsdirect.ca). A secret token (sk.…) is refused.
#
# google — Places API (New), proxied through this application.
#
#   GOOGLE_PLACES_API_KEY comes from the same Google Cloud project as sign-in:
#   APIs & Services → Library → enable "Places API (New)", then Credentials →
#   Create credentials → API key. The project needs a billing account. The key
#   is used from Laravel, never the browser, so restrict it to that one API and
#   to this server's addresses — BOTH of them, IPv4 and IPv6, because the server
#   reaches Google over IPv6. Set a daily quota on the API too: the application
#   rate-limits each customer, but the quota is the only hard ceiling on the bill.
ADDRESS_LOOKUP_PROVIDER=mapbox
MAPBOX_PUBLIC_TOKEN=
GOOGLE_PLACES_API_KEY=
ADDRESS_LOOKUP_TIMEOUT=4

# --- Card payments — Stripe (§4) ---------------------------------------------
# All three are required to take a card, and they do different jobs:
#
#   STRIPE_KEY            Publishable. Handed to the browser by the API, so it
#                         rotates with a restart rather than a frontend rebuild.
#   STRIPE_SECRET         Server only. Never leaves the application.
#   STRIPE_WEBHOOK_SECRET Signs the webhook. WITHOUT IT, NOTHING IS EVER MARKED
#                         PAID — the browser does not decide that, a signed
#                         event from Stripe does. Orders will pile up in Pending
#                         Payment until somebody marks them by hand.
#
# TEST KEYS ARE THE SAFE DEFAULT. `pk_test_…` charges nothing and the admin
# panel says so out loud. Swapping in live keys is the moment real money starts
# moving; do it deliberately, and never on a staging deployment.
#
# Add the endpoint in Stripe → Developers → Webhooks:
#     https://bulkscrubsdirect.ca/api/v1/webhooks/stripe
# subscribed to payment_intent.succeeded, payment_intent.payment_failed and
# charge.refunded, then paste its signing secret below.
#
# Keys alone do not switch cards on: "Accept card payments at checkout" in
# Store settings → Payments has to be enabled too.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_TIMEOUT=20

# --- Stallion Express live shipping rates (§5) -------------------------------
# Without a key the application rates every order from the table rates managed
# in the admin. Setting one only takes effect once "Rating provider" is switched
# to stallion in Store settings.
STALLION_API_KEY=
STALLION_BASE_URL=https://ship.stallionexpress.ca/api/v4
STALLION_TIMEOUT=6

# --- PayPal Checkout (§4) ----------------------------------------------------
# PAYPAL_MODE selects the environment AND must match the credential pair: a live
# client ID is rejected by the sandbox API and vice versa. Develop against
# sandbox credentials from https://developer.paypal.com/dashboard/applications/sandbox
# and swap both values when going live.
#
# THE KEYS ARE NOT THE ONLY GATE. "Accept PayPal" in Store settings is off by
# default and must be switched on before checkout offers PayPal at all, so a live
# key reaching production cannot start charging customers on its own.
#
# PAYPAL_WEBHOOK_ID comes from the webhook you create in the PayPal dashboard,
# pointed at https://bulkscrubsdirect.ca/api/v1/webhooks/paypal and subscribed to
# PAYMENT.CAPTURE.COMPLETED (plus DENIED/REVERSED/REFUNDED for the log). Without
# it the webhook endpoint refuses every delivery rather than trusting an
# unverified one — the browser capture still works, but the safety net for a
# customer who closes the tab mid-payment does not.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT=20

# --- Transactional email (§10) -----------------------------------------------
# Every order notification is built and wired but held behind the "Send order
# emails" switch in Store settings, so configuring a mailer is not enough on its
# own to start sending. Point MAIL_MAILER at a real service before enabling it.
MAIL_MAILER=log

# --- Database backups (§12) ---------------------------------------------------
# `backup:run` is scheduled nightly, with a weekly `--verify` pass that restores
# the dump into a scratch database and counts the tables. It needs the one cron
# entry Laravel always needs:
#
#   * * * * * cd /var/www/bulkscrubs/api && php artisan schedule:run >> /dev/null 2>&1
#
# BACKUP_DISK IS THE ONE THAT MATTERS. Without it, dumps live only on the server
# they are backing up, which protects against a bad migration and nothing else.
# Point it at an S3-compatible bucket in a Canadian region and set the AWS_*
# values above.
BACKUP_DISK=
BACKUP_DISK_PATH=database-backups
BACKUP_PATH=
BACKUP_RETENTION_DAYS=14

# The scratch database `--verify` restores into. Created and dropped each run,
# so the connection user needs CREATE/DROP DATABASE. Must never be the live one.
BACKUP_VERIFY_DATABASE=bulkscrubs_backup_check

# Set these when the MySQL client binaries are not on the web user's PATH.
# On this Windows dev machine they live under C:\xampp\mysql\bin.
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql
